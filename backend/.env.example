PORT=5000

# Local dev (Docker Compose / local install)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopdb?schema=public"
MONGO_URI="mongodb://localhost:27017/shop_reviews"

# Production (Supabase Postgres)
# DATABASE_URL: use Supabase's pooled "Transaction" connection string (port 6543), append ?pgbouncer=true
# DIRECT_URL: use Supabase's direct connection string (port 5432), used only for migrations
# DATABASE_URL="postgresql://postgres:<password>@<project>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:<password>@<project>.pooler.supabase.com:5432/postgres"

# Production (MongoDB Atlas)
# MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shop_reviews"

JWT_SECRET="change_me"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@shop.com"

# Comma-separated list of allowed frontend origins in production, e.g.:
# CORS_ORIGIN="https://your-frontend.vercel.app"
CORS_ORIGIN=
